<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/integrityquiz/db" VERSION="2026091700" COMMENT="XMLDB file for mod_integrityquiz"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="integrityquiz" COMMENT="Integrity Quiz activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timelimit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="3600"/>
        <FIELD NAME="questiontimelimit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptsallowed" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="questionsperpage" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="100"/>
        <FIELD NAME="integritypolicy" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="strict"/>
        <FIELD NAME="requirecamera" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="requirefullscreen" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="suspendontabswitch" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="snapshotmin" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="60"/>
        <FIELD NAME="snapshotmax" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="120"/>
        <FIELD NAME="retentiondays" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="30"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="course_ix" UNIQUE="false" FIELDS="course"/></INDEXES>
    </TABLE>
    <TABLE NAME="integrityquiz_questions" COMMENT="Questions authored for an Integrity Quiz">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="integrityquizid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="qtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="multichoice"/>
        <FIELD NAME="questiontext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="optionsjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="correctjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="feedback" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="marks" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="quiz_fk" TYPE="foreign" FIELDS="integrityquizid" REFTABLE="integrityquiz" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="quiz_sort_ix" UNIQUE="false" FIELDS="integrityquizid, sortorder"/></INDEXES>
    </TABLE>
    <TABLE NAME="integrityquiz_attempts" COMMENT="Student attempts and secure state">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="integrityquizid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptno" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="state" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="active"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinish" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timesuspended" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lastheartbeat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="pageid" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="violations" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="rawscore" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="false"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="quiz_fk" TYPE="foreign" FIELDS="integrityquizid" REFTABLE="integrityquiz" REFFIELDS="id"/><KEY NAME="user_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="quiz_user_attempt_uix" UNIQUE="true" FIELDS="integrityquizid, userid, attemptno"/><INDEX NAME="state_ix" UNIQUE="false" FIELDS="state"/></INDEXES>
    </TABLE>
    <TABLE NAME="integrityquiz_responses" COMMENT="Saved responses">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="responsejson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="fraction" TYPE="number" LENGTH="10" DECIMALS="7" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="mark" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeopened" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeexpired" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="attempt_fk" TYPE="foreign" FIELDS="attemptid" REFTABLE="integrityquiz_attempts" REFFIELDS="id"/><KEY NAME="question_fk" TYPE="foreign" FIELDS="questionid" REFTABLE="integrityquiz_questions" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="attempt_question_uix" UNIQUE="true" FIELDS="attemptid, questionid"/></INDEXES>
    </TABLE>
    <TABLE NAME="integrityquiz_events" COMMENT="Integrity and proctoring events">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="eventtype" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="event"/>
        <FIELD NAME="severity" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="detail" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="clienttime" TYPE="int" LENGTH="13" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="servertime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="prevhash" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="eventhash" TYPE="char" LENGTH="64" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="attempt_fk" TYPE="foreign" FIELDS="attemptid" REFTABLE="integrityquiz_attempts" REFFIELDS="id"/></KEYS>
      <INDEXES><INDEX NAME="attempt_time_ix" UNIQUE="false" FIELDS="attemptid, servertime"/></INDEXES>
    </TABLE>
    <TABLE NAME="integrityquiz_reviews" COMMENT="Teacher review actions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="action" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="review"/>
        <FIELD NAME="oldstate" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="newstate" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="note" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/><KEY NAME="attempt_fk" TYPE="foreign" FIELDS="attemptid" REFTABLE="integrityquiz_attempts" REFFIELDS="id"/><KEY NAME="reviewer_fk" TYPE="foreign" FIELDS="reviewerid" REFTABLE="user" REFFIELDS="id"/></KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
